# WBot connection to SocialPublicator
LARAVEL_API_URL=
# Set the individual token issued by bot-agent:issue-token for this instance.
LARAVEL_API_TOKEN=
BOT_NAME=WBot
BOT_INSTANCE_ID=

# Use unique names and paths for each additional WBot instance.
# Defaults preserve the existing whatsapp-bot session and directories.
WHATSAPP_SESSION_NAME=whatsapp-bot
WHATSAPP_SESSION_DIR=
WHATSAPP_PROFILE_DIR=
WHATSAPP_TOKEN_DIR=
WHATSAPP_LOCK_FILE=
BROWSER_PROFILE_DIR=
BROWSER_PROFILE_BACKUP_DIR=
FACEBOOK_SESSION_DIR=
BOT_API_TIMEOUT_MS=15000

# Social account IDs created in the SocialPublicator workspace.
# WBot validates the token, grants, account types and session ownership before startup.
# Leave both empty to keep WBot running in legacy standalone mode.
SOCIAL_ACCOUNT_ID=

# Optional Facebook profile account for the persistent browser session.
FACEBOOK_SOCIAL_ACCOUNT_ID=

# Existing WhatsApp and Facebook configuration remains unchanged.
